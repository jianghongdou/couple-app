# 情侣 App 服务端 Nginx 反向代理示例配置
#
# 作用：
#   1. HTTPS 终止（iOS 要求 ATS，正式环境必须使用 HTTPS）
#   2. 反向代理到本机 Node 服务（默认 127.0.0.1:8787）
#   3. WebSocket（/ws）升级支持
#   4. 表情图片长缓存
#
# 使用：
#   1. 把 api.example.com 替换为你的域名
#   2. 证书可用 certbot 申请： certbot --nginx -d api.example.com
#   3. 复制到 /etc/nginx/conf.d/couple-server.conf 后执行 nginx -t && nginx -s reload
#
# 提示：客户端 Base URL 应为 https://api.example.com/api

# WebSocket 升级所需的 Connection 头映射
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# HTTP：全部跳转到 HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name api.example.com;

    # 保留 certbot 校验路径
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS 主站
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name api.example.com;

    # ===== 证书（certbot 会自动写入下面两行）=====
    ssl_certificate     /etc/letsencrypt/live/api.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.example.com/privkey.pem;

    # ===== TLS 安全配置 =====
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # HSTS（确认全站 HTTPS 后再打开）
    add_header Strict-Transport-Security "max-age=31536000" always;

    # 安全响应头
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    # 上传体积：表情为 base64 上传，解码后上限 1MB，留足余量
    client_max_body_size 8m;

    # 超时：AI 接口可能耗时较久
    proxy_connect_timeout 10s;
    proxy_send_timeout    120s;
    proxy_read_timeout    120s;

    # 通用代理头
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $host;

    # gzip 压缩（图片不压缩）
    gzip on;
    gzip_types application/json text/plain text/css application/javascript;
    gzip_min_length 1024;

    # ===== WebSocket 实时推送 =====
    location /ws {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        # 升级为 WebSocket 的关键两行
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # 长连接：读超时需大于客户端 25 秒心跳间隔
        proxy_read_timeout  3600s;
        proxy_send_timeout  3600s;
        proxy_buffering off;
    }

    # ===== 表情图片二进制：长缓存 =====
    # 注意：blob 接口需要 token，故此处不缓存到 CDN，仅交给浏览器缓存
    location /api/emoji/blob/ {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering on;
        proxy_cache_valid 200 365d;
    }

    # ===== 后台管理页面 =====
    location /admin {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ===== REST API =====
    location /api/ {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
    }

    # 根路径说明页
    location = / {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
    }

    # 其它路径一律 404，避免暴露无关内容
    location / {
        return 404;
    }
}
