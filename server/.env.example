# 情侣 App 服务端 —— 环境变量示例
# 使用方法：复制本文件为 .env，然后按需修改
#   cp .env.example .env

# ===== 必填项（不填服务会拒绝启动）=====

# 用户 token 签名密钥，要求 ≥32 位随机串
# 生成方式（复制输出粘到下面）：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ 故意留空：不填服务会拒绝启动，避免有人直接用示例里的弱密钥上线
JWT_SECRET=

# 后台管理登录密码（至少 6 位，建议 12 位以上）
# ⚠️ 同样故意留空，请自行设置一个强密码
ADMIN_PASSWORD=

# ===== 可选项 =====

# 监听端口，默认 8787
PORT=8787

# 数据目录（SQLite 数据库与表情图片存放位置），默认 ./data
# 相对路径基于 server/ 目录解析
DATA_DIR=./data

# 后台 token 签名密钥，缺省回退到 JWT_SECRET
# 生产环境建议单独设置，使后台 token 与用户 token 完全隔离
# ADMIN_JWT_SECRET=另一个独立的随机字符串至少32位

# 表情绝对地址前缀，可留空（留空时返回相对地址 /api/emoji/blob/xxx）
# 例： https://api.example.com
PUBLIC_BASE_URL=

# 是否信任反向代理的 X-Forwarded-For，默认 1（信任）
# 直接暴露到公网且无代理时建议设为 0
TRUST_PROXY=1

# 日志级别：debug | info | warn | error | silent，默认 info
LOG_LEVEL=info
